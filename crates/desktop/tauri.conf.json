{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tukitermlulu",
  "version": "0.1.0",
  "identifier": "dev.tukitermlulu.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "tukitermlulu",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "dmg", "app"],
    "publisher": "tukitermlulu",
    "homepage": "https://github.com/Leuname0410/tukitermlulu",
    "copyright": "Copyright (c) 2026 Leuname0410",
    "category": "DeveloperTool",
    "license": "MPL-2.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "SSH/SFTP terminal client with tabs, sessions and file transfers",
    "longDescription": "tukitermlulu is an open-source SSH/SFTP desktop client inspired by MobaXterm. It offers tabbed terminals, saved sessions and a built-in file manager.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
